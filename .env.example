# Copy to .env and fill in:  cp .env.example .env

# Image tag. Server, addon/mod and player apps must all be on the same release.
BVC_VERSION=1.0.0-beta.23

# Domain pointing at THIS VPS (A/AAAA record). A bare IP does not work.
BVC_DOMAIN=voice.example.com

# Let's Encrypt account email.
BVC_ACME_EMAIL=you@example.com

# Cloudflare API token: scoped to ONE zone with "Zone > DNS > Edit" permission.
# Do NOT use the global API key.
CF_API_TOKEN=replace-me

# Required by the server config. A Realm (no-net addon) doesn't use it; it's the shared
# secret for a self-hosted BDS / Java server with the HTTP addon or mod.
# Generate with:  openssl rand -hex 32   (setup.sh does this for you)
BVC_ACCESS_TOKEN=change-me
