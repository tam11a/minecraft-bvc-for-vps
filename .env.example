# Copy to .env (setup.sh does this) and fill in ONE of the TLS options below.

# BVC release. Server, Realm addon and players' apps must all be on the same release.
BVC_VERSION=1.0.0-beta.23

# Hostname players type into the BVC app. BVC needs a hostname with a real certificate;
# a bare IP address does not work.
#   No domain (option A): a free DuckDNS name, e.g. mycraftvoice.duckdns.org
#   Own domain (option B): e.g. voice.example.com
BVC_DOMAIN=yourname.duckdns.org

# ---------------------------------------------------------------------------
# TLS option A: free DuckDNS subdomain (no domain needed). Default.
#   1. Sign in at https://www.duckdns.org, add your subdomain, copy the token shown at the top.
#   2. `bash cert.sh` points the name at this VPS and gets the certificate.
#   3. A daily cron job runs `bash cert.sh` to renew it (see DEPLOY.md).
DUCKDNS_TOKEN=
CERT_EMAIL=
BVC_TLS_CERTIFICATE=/data/tls/fullchain.pem
BVC_TLS_KEY=/data/tls/privkey.pem

# ---------------------------------------------------------------------------
# TLS option B: your own domain with DNS on Cloudflare. BVC gets and renews the
# certificate itself. To use it, EMPTY the four option A values above (the server
# refuses to start with both) and fill these in.
#   Token: Cloudflare > My Profile > API Tokens > "Edit zone DNS", limited to one zone.
BVC_ACME_PROVIDER=
BVC_ACME_EMAIL=
BVC_ACME_API_TOKEN=
